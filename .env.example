# ===== LeadHub — biến môi trường cho docker compose =====
# Sao chép thành .env và đổi các giá trị bí mật trước khi chạy production.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=leadhub
MYSQL_USER=leadhub
MYSQL_PASSWORD=change-me-leadhub

# Backend
# Bắt buộc >= 32 ký tự. Tạo bằng: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# true = tạo dữ liệu & tài khoản demo khi DB trống (tắt ở production)
APP_SEED_DEMO=true
# Origin landing được gửi lead (phân tách bằng dấu phẩy). * = mọi origin
APP_CORS_PUBLIC_ORIGINS=*

# URL công khai của API mà trình duyệt (landing) gọi tới
PUBLIC_API_URL=http://localhost:8080

# Cổng public
ADMIN_PORT=3000
API_PORT=8080
LANDING_REAL_ESTATE_PORT=5101
LANDING_INTERIOR_PORT=5102
LANDING_EDUCATION_PORT=5103
